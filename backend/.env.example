# Filled in during Phase 3+. Keep this committed; copy to `.env` and edit.

# --- Phase 3: LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Phase 3: TTS ---
# piper = local ``piper-tts`` Python package (recommended; no CLI binary).
# piper-cli = ``piper`` subprocess (see install script + Rosetta notes below).
JARVIS_TTS_PROVIDER=piper
# Piper binary (see ``bash scripts/install_piper_macos_aarch64.sh`` for official bundle).
# Do not define ``PIPER_CMD`` twice in ``.env`` — the last value wins and can break TTS.
PIPER_CMD=data/piper/macos-aarch64/piper/piper
# Apple Silicon note: GitHub's ``piper_macos_aarch64`` archive is often **x86_64** (Intel).
# Check: ``file "$(dirname "$PIPER_CMD")/piper"`` — if it says x86_64, use Rosetta + Intel espeak-ng:
#   1) ``softwareupdate --install-rosetta`` (once)
#   2) Install Homebrew **x86** under ``/usr/local`` (see brew.sh “Intel Mac” / Rosetta instructions), then:
#      ``arch -x86_64 /usr/local/bin/brew install espeak-ng``
#   3) Here:
# PIPER_PREFIX_ARGS=arch -x86_64
# PIPER_DYLD_LIBRARY_PATH=/usr/local/opt/espeak-ng/lib
# Path to Piper .onnx (relative = from backend/). Voice: ``uv run python scripts/download_piper_voice.py``
# en_US-danny-low = robotic JARVIS-style male; en_US-lessac-medium = clearer/natural.
PIPER_MODEL=data/piper/en_US-danny-low.onnx
# < 1.0 = faster/snappier speech (default 0.9).
# PIPER_LENGTH_SCALE=0.9
# PIPER_CONFIG=/absolute/path/to/custom.json
# PIPER_TIMEOUT_S=120
# Seconds between INFO logs while a Piper subprocess is running (shows progress during long Rosetta loads).
# PIPER_LOG_HEARTBEAT_S=15
# Startup ONNX warmup blocks ``uvicorn`` until one subprocess completes (Rosetta/x86 may hang → leave off).
# PIPER_WARMUP_ON_START=1

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Phase 3: STT (faster-whisper; device=cpu on Apple Silicon — no CUDA/MPS) ---
# Model tiers: base.en < small.en < medium.en < large-v3 (best WER, ~3GB+, slowest on CPU).
# large-v3 is multilingual — set WHISPER_LANGUAGE=en for English-only (skips autodetect).
# int8_float16 works on many CUDA setups; Apple Silicon CPU often needs int8 or float16.
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 1 = greedy (fast). 5 = stronger decoding (slower); try 3 on slower machines.
WHISPER_BEAM_SIZE=1
# Optional ISO 639-1 (e.g. en). Use with large-v3 / other multilingual checkpoints.
# WHISPER_LANGUAGE=en

# --- Frontend (optional; for profile setup fetch from browser) ---
# NEXT_PUBLIC_JARVIS_HTTP_URL=http://127.0.0.1:8000

# --- Phase 5: tools + memory ---
# Web search (https://tavily.com)
TAVILY_API_KEY=

# Sandboxed directory for list_directory / read_file (created if missing)
JARVIS_FS_ROOT=

# Optional: path to a local calendar file for calendar_upcoming
JARVIS_CALENDAR_ICS=

# ChromaDB persistence (default: backend/data/chroma)
JARVIS_CHROMA_PATH=

# HuggingFace tokenizers: avoid fork deadlock warnings (default ``false`` in ``main.py``).
# TOKENIZERS_PARALLELISM=false

# Embedding model id for sentence-transformers (optional)
# JARVIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Khas Bazaar marketing: Buffer (Instagram posting) ---
# Buffer API key (Bearer) from Buffer account settings / developers.buffer.com.
# "post it on insta" uploads the generated image (hosted on Google Drive) and
# publishes immediately to the connected Instagram channel via Buffer.
BUFFER_ACCESS_TOKEN=
# Optional: pin the Instagram channel id (else auto-discovered).
BUFFER_IG_CHANNEL_ID=
# Optional: Drive folder used to host post images (default: "Khas Bazaar Posts").
# KB_DRIVE_FOLDER=Khas Bazaar Posts
